local function dungeonPositions()
	local list = {}
	local b = Rec.blocks[Rec.cur]
	if b then
		for _, m in pairs(b.models) do
			if m.k == "dungeon" then
				list[#list + 1] = Vector3.new(m.x, m.y, m.z)
			end
		end
	end
	return list
end

-- ===== Streaming'i asma (v5.2) =====
-- CANLI TEST SONUCLARI:
--  * Player:RequestStreamAroundAsync HICBIR ZAMAN geri donmuyor ama bolgeyi ~3-5sn yukluyor
--    -> bekleme yok: thread'i at, 4sn sonra iptal et (pulse).
--  * Birden fazla istek ayni anda calisiyor; istek yaricapi ~400 stud.
--  * workspace.StreamingEnabled=false istemciden yazilabiliyor ama sunucu yine gondermiyor (ise yaramiyor).
--  * Zindanlar kapi z'sinden (-658 kuzey / -882 guney) yoldan uzaga ~2000 stud uzaniyor; SpiderPit y=600'e kadar.
local DUNGEON_NAMES = { "Dungeon", "SpiderPit", "SpiderTunnel", "VampireMansion", "Mineshaft" }
local function isDungeonModel(m)
	for _, p in ipairs(DUNGEON_NAMES) do
		if string.find(m.Name, p, 1, true) then
			return true
		end
	end
	return false
end

local function pulse(pos)
	local th = task.spawn(function()
		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(pos, 3)
		end)
	end)
	task.delay(4, function()
		pcall(task.cancel, th)
	end)
end

local SHAPES = {
	{ "SpiderPit", { dz = { 0, 400, 800, 1200, 1600 }, ys = { 0, 300, 600 }, xs = { 0 } } },
	{ "Mineshaft", { dz = { 400, 800, 1200, 1600, 2000 }, ys = { 0 }, xs = { 0 } } },
	{ "VampireMansion", { dz = { 0, 400, 800 }, ys = { 0 }, xs = { 0 } } },
	{ "SpiderTunnel", { dz = { 300, 700, 1000 }, ys = { 0 }, xs = { 0 } } },
	{ "Tier3C", { dz = { 0, 400, 800 }, ys = { 0 }, xs = { -250, 0, 250 } } },
	{ "Tutorial", { dz = { 0, 400, 800 }, ys = { 0 }, xs = { -400, 0, 400 } } },
	{ "DungeonGate", { dz = { 0, 400, 800 }, ys = { 0 }, xs = { 0 } } },
}
local DEFAULT_SHAPE = { dz = { 0, 500, 1000, 1500, 2000 }, ys = { 0, 300 }, xs = { 0 } }

local function roadZ()
	local e = Workspace:GetAttribute("End_Position")
	return (typeof(e) == "Vector3") and e.Z or -771
end

local function gridFor(m)
	local pts = {}
	local p = posOf(m)
	if not p then
		return pts
	end
	local rz = roadZ()
	local sign = (p.Z > rz) and 1 or -1
	local base = Vector3.new(p.X, 35, rz + (sign > 0 and 113 or -111))
	local shape = DEFAULT_SHAPE
	for _, s in ipairs(SHAPES) do
		if string.find(m.Name, s[1], 1, true) then
			shape = s[2]
			break
		end
	end
	for _, dx in ipairs(shape.xs) do
		for _, dy in ipairs(shape.ys) do
			for _, dz in ipairs(shape.dz) do
				pts[#pts + 1] = base + Vector3.new(dx, dy, dz * sign)
			end
		end
	end
	local ok, cf, size = pcall(function()
		return m:GetBoundingBox()
	end)
	if ok and size and size.Magnitude > 50 then
		local mn = cf.Position - size / 2
		local mx = cf.Position + size / 2
		for x = mn.X + 150, mx.X + 150, 300 do
			for y = mn.Y + 150, mx.Y + 150, 300 do
				for z = mn.Z + 150, mx.Z + 150, 300 do
					if #pts < 120 then
						pts[#pts + 1] = Vector3.new(x, y, z)
					end
				end
			end
		end
	end
	return pts
end

local function streamPositions()
	local list = {}
	local function add(p, sep)
		sep = sep or 250
		for _, q in ipairs(list) do
			if (q - p).Magnitude < sep then
				return
			end
		end
		list[#list + 1] = p
	end
	local inDungeon = LocalPlayer:GetAttribute("InDungeon") == true
	if inDungeon then
		local me = charPivot()
		add(me, 1)
		for _, o in ipairs({ Vector3.new(300, 0, 0), Vector3.new(-300, 0, 0), Vector3.new(0, 0, 300), Vector3.new(0, 0, -300), Vector3.new(0, 150, 0), Vector3.new(0, -150, 0) }) do
			add(me + o, 1)
		end
		local bestPts, bestD = nil, 1e12
		for _, m in ipairs(Workspace:GetChildren()) do
			if m:IsA("Model") and isDungeonModel(m) then
				local pts = gridFor(m)
				local md = 1e12
				for _, q in ipairs(pts) do
					local d = (q - me).Magnitude
					if d < md then
						md = d
					end
				end
				if md < bestD then
					bestPts, bestD = pts, md
				end
			end
		end
		if bestPts and bestD < 3000 then
			for _, q in ipairs(bestPts) do
				add(q, 200)
			end
		end
		return list
	end
	local rz = roadZ()
	local endPos = Workspace:GetAttribute("End_Position")
	local startPos = Workspace:GetAttribute("Start_Position")
	local x0 = (typeof(startPos) == "Vector3") and (startPos.X - 100) or -800
	local x1 = (typeof(endPos) == "Vector3") and (endPos.X + 600) or 33800
	local drill = Workspace:FindFirstChild("Drill")
	local dp = drill and posOf(drill)
	if dp and dp.X + 8000 > x1 then
		x1 = dp.X + 8000
	end
	if Config.DungeonGrid then
		for _, m in ipairs(Workspace:GetChildren()) do
			if m:IsA("Model") and isDungeonModel(m) then
				for _, q in ipairs(gridFor(m)) do
					add(q, 200)
				end
			end
		end
	end
	for _, off in ipairs({ 0, 500, -500, 1000, -1000, 1500, -1500, 2000, -2000 }) do
		local x = x0
		while x <= x1 do
			add(Vector3.new(x, 4, rz + off), 300)
			x = x + 700
		end
	end
	for _, m in ipairs(Workspace:GetChildren()) do
		if m:IsA("Model") and not SKIP_MODELS[m.Name] and m ~= LocalPlayer.Character and not string.find(m.Name, "_CameraFocus", 1, true) then
			local p = posOf(m)
			if p then
				add(p, 300)
			end
		end
	end
	return list
end

local function rememberOres()
	local of = Workspace:FindFirstChild("Ores")
	if not of then
		return
	end
	for _, o in ipairs(of:GetChildren()) do
		local p = posOf(o)
		if p and oreHealth(o) > 0 then
			Hub.OreMem[o.Name .. "|" .. r1(p.X) .. "|" .. r1(p.Z)] = { t = sessionTypeOf(o), x = r1(p.X), y = r1(p.Y), z = r1(p.Z) }
		end
	end
end

local function requestStream(pos)
	pulse(pos)
	task.wait(Config.StreamWait)
	return true
end

-- konumlari Config.StreamBatch'lik gruplar halinde ayni anda ister; stepFn(pos) true donerse tarama durur
local function sweepStream(stepFn, stopFn)
	local list = streamPositions()
	Hub.SweepTotal = #list
	local back, moved = nil, false
	local result = true
	local i = 1
	while i <= #list do
		if not State.running or (stopFn and stopFn()) then
			result = false
			break
		end
		local last = math.min(i + Config.StreamBatch - 1, #list)
		for k = i, last do
			pulse(list[k])
		end
		if Hub.SweepTeleport then
			if not moved then
				back = tpSave()
				moved = true
			end
			tpToPos(list[i], 6)
		end
		task.wait(Config.StreamWait)
		Hub.SweepIdx = last
		rememberOres()
		if stepFn then
			local ok, stop = pcall(stepFn, list[i])
			if ok and stop == true then
				result = true
				break
			end
		end
		i = last + 1
	end
	if moved then
		tpBack(back)
	end
	return result
end

