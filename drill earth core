local function isAlive()
	local ch = LocalPlayer.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

local function hrp()
	local ch = LocalPlayer.Character
	return ch and ch:FindFirstChild("HumanoidRootPart") or nil
end

local function posOf(inst)
	if not inst then
		return nil
	end
	local ok, cf = pcall(function()
		return inst:GetPivot()
	end)
	if ok and cf then
		return cf.Position
	end
	if inst:IsA("BasePart") then
		return inst.Position
	end
	return nil
end

local function charPivot()
	local h = hrp()
	if h then
		return h.Position
	end
	return posOf(LocalPlayer.Character) or Vector3.new(0, 0, 0)
end

-- ===== World tarayici: Workspace'in TUM alt dallari, surekli =====
local function topChild(d)
	local a = d
	while a.Parent and a.Parent ~= RealWorkspace do
		a = a.Parent
	end
	return a
end

local function skipTree(d)
	local top = topChild(d)
	local n = top.Name
	if n == "Chunks" or n == "Npc" or string.sub(n, 1, 8) == "CutScene" then
		return true
	end
	if top:IsA("Model") and top:FindFirstChildOfClass("Humanoid") then
		return true
	end
	local a = d.Parent
	while a and a ~= RealWorkspace do
		if a:IsA("Tool") or a.Name == "WeldFolder" then
			return true
		end
		a = a.Parent
	end
	return false
end

local function classify(d)
	if not (d:IsA("Model") or d:IsA("BasePart")) then
		return
	end
	if d:IsA("Model") and d:GetAttribute("Category") == "Corpse" then
		World.corpses[d] = true
		return
	end
	local par = d.Parent
	if d:GetAttribute("SessionOreType") ~= nil then
		if not (par and par:GetAttribute("SessionOreType") ~= nil) then
			World.ores[d] = true
		end
	elseif d:GetAttribute("ItemDatabaseId") ~= nil or d:GetAttribute("ItemDatabaseTemplate") ~= nil then
		if par and (par:GetAttribute("ItemDatabaseId") ~= nil or par:GetAttribute("ItemDatabaseTemplate") ~= nil) then
			return
		end
		if not skipTree(d) then
			World.items[d] = true
		end
	end
end

addConn(RealWorkspace.DescendantAdded:Connect(function(d)
	task.defer(classify, d)
end))

-- zaman butceli artimli tarama (her Config.ScanTick'te yeni tur). Yeni olusan her sey DescendantAdded ile ANINDA yakalanir.
-- Agir ve alakasiz agaclar (Chunks, CutScene*, Npc, Terrain) tur disi: tam tur ~6ms.
do
	local snap, idx, lastStart = {}, 1, 0
	local SKIP_TOP = { Chunks = true, Npc = true, Terrain = true, Camera = true }
	local function buildSnapshot()
		local out = {}
		for _, c in ipairs(RealWorkspace:GetChildren()) do
			local n = c.Name
			if not SKIP_TOP[n] and string.sub(n, 1, 8) ~= "CutScene" then
				out[#out + 1] = c
				local ds = c:GetDescendants()
				table.move(ds, 1, #ds, #out + 1, out)
			end
		end
		return out
	end
	addConn(RunService.Heartbeat:Connect(function()
		if not State.running then
			return
		end
		local t0 = os.clock()
		if idx > #snap then
			if t0 - lastStart >= Config.ScanTick then
				listOf(World.items)
				listOf(World.ores)
				listOf(World.corpses)
				snap = buildSnapshot()
				idx = 1
				lastStart = t0
			end
			return
		end
		local budget = (Config.ScanBudget or 4) / 1000
		while idx <= #snap do
			classify(snap[idx])
			idx = idx + 1
			if idx % 100 == 0 and os.clock() - t0 > budget then
				break
			end
		end
	end))
end

-- ===== Alet yonetimi =====
local function activeToolName()
	local tc = ctrl("ToolController")
	if not tc then
		return nil
	end
	local ok, nm = pcall(function()
		local at = tc.ActiveTool
		if at and at.Tool and at.Tool.Parent then
			return at.Tool.Name
		end
		return nil
	end)
	if ok then
		return nm
	end
	return nil
end

local function findTool(fn)
	local ch = LocalPlayer.Character
	if ch then
		for _, t in ipairs(ch:GetChildren()) do
			if t:IsA("Tool") and fn(t) then
				return t, true
			end
		end
	end
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	if bp then
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") and fn(t) then
				return t, false
			end
		end
	end
	return nil, false
end

local function ensureToolMatch(fn)
	if not isAlive() then
		return nil
	end
	local ch = LocalPlayer.Character
	if not ch then
		return nil
	end
	if activeToolName() ~= nil then
		for _, t in ipairs(ch:GetChildren()) do
			if t:IsA("Tool") and fn(t) then
				return t
			end
		end
	end
	local cand = findTool(fn)
	if not cand then
		return nil
	end
	local svc = getToolService()
	if svc then
		if activeToolName() ~= nil then
			pcall(function()
				if svc.UnequipTool then
					svc:UnequipTool()
				end
			end)
			task.wait(0.6)
		end
		pcall(function()
			if svc.EquipTool then
				svc:EquipTool(cand)
			end
		end)
		local t0 = os.clock()
		while os.clock() - t0 < 3 do
			if cand.Parent == ch and activeToolName() ~= nil then
				task.wait(0.2)
				return cand
			end
			task.wait(0.1)
		end
		if cand.Parent == ch then
			return cand
		end
		return nil
	end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	if hum and cand.Parent ~= ch then
		pcall(function()
			hum:EquipTool(cand)
		end)
	end
	return cand
end

local function isBagTool(t)
	return t ~= nil and (t.Name == "ItemBag" or t.Name == "Large_Sack" or GA(t, "Class") == "ItemBag")
end

local function ensureBag()
	return ensureToolMatch(isBagTool) ~= nil
end

local function isPickaxeTool(t)
	return GA(t, "Class") == "Pickaxe" or string.find(string.lower(t.Name), "pickaxe") ~= nil
end

local function ensurePickaxe()
	return ensureToolMatch(isPickaxeTool) ~= nil
end

local function isMedkitTool(t)
	if GA(t, "Class") == "Medkit" then
		return true
	end
	local n = string.lower(t.Name)
	return string.find(n, "medkit") ~= nil or string.find(n, "bandage") ~= nil
end

