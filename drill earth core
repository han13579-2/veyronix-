local FlyS = { vel = Vector3.zero, hold = nil }
addConn(RunService.Heartbeat:Connect(function(dt)
	if not State.running then
		return
	end
	local mining = Config.AutoMine and Config.Float and State.target and State.target.Parent
	if not (Config.Fly and isAlive()) or _G.HubBusy or mining then
		FlyS.vel = Vector3.zero
		FlyS.hold = nil
		return
	end
	local h = hrp()
	local ch = LocalPlayer.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local cam = Workspace.CurrentCamera
	if not (h and hum and cam) then
		return
	end
	local typing = UserInputService:GetFocusedTextBox() ~= nil
	local dir = Vector3.zero
	if not typing then
		local cf = cam.CFrame
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			dir = dir + cf.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			dir = dir - cf.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			dir = dir + cf.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			dir = dir - cf.RightVector
		end
	end
	if dir.Magnitude < 0.1 and hum.MoveDirection.Magnitude > 0.1 then
		dir = hum.MoveDirection
	end
	local vy = 0
	if not typing then
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			vy = 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			vy = -1
		end
	end
	if hum.Jump then
		vy = 1
	end
	local desired = Vector3.zero
	if dir.Magnitude > 0.1 then
		desired = dir.Unit * Config.FlySpeed
	end
	desired = desired + Vector3.new(0, vy * Config.FlySpeed, 0)
	local a = 1 - math.exp(-14 * dt)
	FlyS.vel = FlyS.vel:Lerp(desired, a)
	if desired.Magnitude < 0.1 and FlyS.vel.Magnitude < 2 then
		-- hedef hiz sifir: oldugun yerde havada kilitle
		FlyS.vel = Vector3.zero
		if not FlyS.hold then
			FlyS.hold = h.CFrame
		end
		h.CFrame = FlyS.hold
	else
		h.CFrame = h.CFrame + FlyS.vel * dt
		FlyS.hold = h.CFrame
	end
	h.AssemblyLinearVelocity = Vector3.zero
	h.AssemblyAngularVelocity = Vector3.zero
end))

