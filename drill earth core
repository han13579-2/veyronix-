local function medkitTool()
	return (findTool(isMedkitTool))
end

local function acquireMedkit()
	if medkitTool() then
		return true
	end
	if not Config.HealGet then
		return false
	end
	-- 1) yerde duran bedava medkit (Items'in tum alt dallari)
	local items = Workspace:FindFirstChild("Items")
	local best, bd = nil, 1e12
	local me = charPivot()
	if items then
		for _, it in ipairs(items:GetChildren()) do
			if it.Parent and GA(it, "Class") == "Medkit" and not CollectionService:HasTag(it, "ShopItem") and canStore(it) and not recentlyFailed(it) then
				local p = posOf(it)
				if p then
					local d = (p - me).Magnitude
					if d < bd then
						best, bd = it, d
					end
				end
			end
		end
	end
	if best then
		if _G.HubBusy or not acquire("heal-get") then
			return false
		end
		local ok = false
		pcall(function()
			local back = tpSave()
			tpToPos(posOf(best), 3)
			task.wait(0.7)
			local isvc = service("InteractionService")
			for _ = 1, 3 do
				if not best.Parent then
					break
				end
				pcall(function()
					isvc:Interact(best)
				end)
				task.wait(1.0)
				if medkitTool() then
					break
				end
			end
			ok = medkitTool() ~= nil
			if not ok then
				Hub.Fail[best] = os.clock()
			end
			tpBack(back)
		end)
		release()
		Hub.HealStatus = ok and T("medkit alindi") or T("medkit alinamadi")
		return ok
	end
	-- 2) shop'tan en ucuzunu satin al
	local cheapest, cc = nil, 1e12
	for _, it in ipairs(CollectionService:GetTagged("ShopItem")) do
		if GA(it, "Class") == "Medkit" and not Hub.ShopBought[it] then
			local cost = tonumber(it:GetAttribute("Cost")) or 1e9
			if cost < cc then
				cheapest, cc = it, cost
			end
		end
	end
	if cheapest and not _G.HubBusy and acquire("heal-buy") then
		Hub.HealStatus = T("shop'tan aliniyor: ") .. cheapest.Name
		local back = tpSave()
		pcall(shopBuy, cheapest)
		tpBack(back)
		release()
		return medkitTool() ~= nil
	end
	return false
end

