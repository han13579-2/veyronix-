local function gearCandidates()
	local items = Workspace:FindFirstChild("Items")
	local list = {}
	if not items then
		return list
	end
	local best = currentBest()
	local myPos = charPivot()
	for _, it in ipairs(items:GetChildren()) do
		if canStore(it) and not recentlyFailed(it) then
			local slot = slotOf(it)
			if slot then
				local p = posOf(it)
				if p and (p - myPos).Magnitude <= Hub.GearRange then
					local s = scoreOf(it, slot)
					local cur = best[slot]
					if cur == nil or s > cur then
						list[#list + 1] = { it = it, s = s, slot = slot, d = (p - myPos).Magnitude, cur = cur }
					end
				end
			end
		end
	end
	table.sort(list, function(a, b)
		if a.slot == b.slot then
			return a.s > b.s
		end
		return a.d < b.d
	end)
	return list
end

