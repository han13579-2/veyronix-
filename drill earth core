-- ===== Oto yakit =====
local function nearestFuel(fromPos)
	local items = Workspace:FindFirstChild("Items")
	if not items then
		return nil
	end
	local best, bd = nil, 1e12
	for _, it in ipairs(items:GetChildren()) do
		if isFuelItem(it) and Hub.FuelOn[it.Name] ~= false and canStore(it) and not recentlyFailed(it) then
			local p = posOf(it)
			if p then
				local d = (p - fromPos).Magnitude
				if d < bd then
					best, bd = it, d
				end
			end
		end
	end
	return best
end

local function fuelCandidates()
	local list = {}
	local items = Workspace:FindFirstChild("Items")
	if not items then
		return list
	end
	local me = charPivot()
	for _, it in ipairs(items:GetChildren()) do
		if it.Parent and isFuelItem(it) and Hub.FuelOn[it.Name] ~= false and canStore(it) and not recentlyFailed(it) and not Hub.Dropped[it] then
			local p = posOf(it)
			if p then
				list[#list + 1] = { it = it, d = (p - me).Magnitude, f = GA(it, "Fuel") or 0 }
			end
		end
	end
	table.sort(list, function(a, b)
		if a.f ~= b.f then
			return a.f > b.f
		end
		return a.d < b.d
	end)
	return list
end

-- canta dolana kadar yakit topla: en cok yakit veren once, arka arkaya (boru hatli), haritanin her yerinden
local function collectFuel()
	if not ensureBag() then
		Hub.FuelStatus = T("canta yok")
		return 0
	end
	local got = 0
	while State.running and isAlive() do
		local size, max = bagInfo()
		if size == nil then
			ensureBag()
			size, max = bagInfo()
		end
		if size and max and size >= max then
			break
		end
		local list = fuelCandidates()
		if #list == 0 then
			Hub.FuelStatus = T("yakit araniyor (harita taramasi)")
			local found = false
			sweepStream(function()
				touchBusy()
				if #fuelCandidates() > 0 then
					found = true
					return true
				end
				return false
			end)
			if found then
				list = fuelCandidates()
			end
		end
		if #list == 0 then
			break
		end
		local room = (size and max) and (max - size) or 5
		local batch = {}
		for i = 1, math.min(#list, math.max(1, math.min(room, 8))) do
			batch[#batch + 1] = list[i]
		end
		local svc = getToolService()
		for _, e in ipairs(batch) do
			Hub.FuelStatus = T("topluyor ") .. e.it.Name
			pcall(function()
				svc.Update:Fire({ "Pickup", e.it })
			end)
			task.wait(Config.PickupInterval)
		end
		local t0 = os.clock()
		while os.clock() - t0 < 0.8 do
			local all = true
			for _, e in ipairs(batch) do
				if e.it.Parent then
					all = false
					break
				end
			end
			if all then
				break
			end
			task.wait(0.05)
		end
		for _, e in ipairs(batch) do
			local it = e.it
			local ok = it.Parent == nil
			if not ok then
				ok = bagPickup(it, 1.0)
			end
			if not ok and it.Parent then
				local p = posOf(it)
				if p then
					tpToPos(p, 3)
					task.wait(0.5)
					ok = bagPickup(it, 2.0)
				end
			end
			if ok then
				got = got + 1
			elseif it.Parent then
				Hub.Fail[it] = os.clock()
			end
		end
		touchBusy()
	end
	return got
end

-- drill'in ortasina gidip yakit dolana (veya canta bosalana) kadar HEMEN birak (DropAll)
local function dropFuel()
	local drop = drillDumpPos()
	if not drop then
		Hub.FuelStatus = T("drill yok")
		return
	end
	tpToPos(drop, 6)
	task.wait(0.3)
	ensureBag()
	local _, f0 = drillFuelPct()
	local svc = getToolService()
	local itemsF = Workspace:FindFirstChild("Items")
	local before = {}
	if itemsF then
		for _, it in ipairs(itemsF:GetChildren()) do
			before[it] = true
		end
	end
	for _ = 1, 4 do
		if not State.running or not isAlive() then
			break
		end
		if drillFuelPct() >= 99 then
			break
		end
		local size = bagInfo()
		if not size or size <= 0 then
			break
		end
		Hub.FuelStatus = T("birakiyor")
		pcall(function()
			svc.Update:Fire({ Config.FuelFast and "DropAll" or "Drop" })
		end)
		local t0 = os.clock()
		while os.clock() - t0 < 1.5 do
			task.wait(0.1)
			local s = bagInfo()
			if s and s < size and Config.FuelFast and s == 0 then
				break
			elseif s and s < size and not Config.FuelFast then
				break
			end
		end
		touchBusy()
	end
	if itemsF then
		task.wait(0.3)
		for _, it in ipairs(itemsF:GetChildren()) do
			if not before[it] then
				Hub.Dropped[it] = true
			end
		end
	end
	local _, f1 = drillFuelPct()
	Hub.FuelDone = Hub.FuelDone + math.max(0, math.floor(f1 - f0))
end

task.spawn(function()
	while State.running do
		if Hub.FuelAuto and isAlive() then
			local pct = drillFuelPct()
			if pct < Hub.FuelPct and not _G.HubBusy then
				if acquire("fuel") then
					pcall(function()
						local back = tpSave()
						for _ = 1, 4 do
							if not State.running or drillFuelPct() >= 99 then
								break
							end
							ensureBag()
							local size = bagInfo()
							if size and size > 0 then
								dropFuel()
							else
								local got = collectFuel()
								if got == 0 then
									Hub.FuelStatus = T("yakit yok")
									break
								end
							end
						end
						tpBack(back)
					end)
					release()
				end
			elseif pct >= Hub.FuelPct then
				Hub.FuelStatus = T("depo yeterli")
			end
			task.wait(math.max(0.1, Config.ScanTick))
		else
			task.wait(1)
		end
	end
end)

-- ===== Oto shop (cursor'suz surukleme) =====
local function findBuyPart(nearPos, radius)
	local best, bd = nil, radius
	for _, p in ipairs(CollectionService:GetTagged("BuyPart")) do
		if p:IsA("BasePart") then
			local d = (p.Position - nearPos).Magnitude
			if d < bd then
				best, bd = p, d
			end
		end
	end
	return best
end

local function shopBuy(item)
	local ipos = posOf(item)
	if not ipos then
		return
	end
	-- 1) once isinlan, kasa (BuyPart) stream olsun
	tpToPos(ipos, 4)
	task.wait(1.2)
	local bp = nil
	local t0 = os.clock()
	while os.clock() - t0 < 8 and State.running do
		bp = findBuyPart(ipos, 500)
		if bp then
			break
		end
		tpToPos(ipos, 4)
		task.wait(0.5)
		touchBusy()
	end
	if not bp then
		Hub.ShopStatus = T("kasa yok: ") .. item.Name
		Hub.ShopBought[item] = true
		return
	end
	local dc = ctrl("DragController")
	if not dc then
		Hub.ShopStatus = T("DragController yok")
		return
	end
	ensureBag() -- canta surukleme engellemez
	-- 2) kilitle
	local locked = false
	for _try = 1, 3 do
		pcall(function()
			dc:TryLockTarget(item)
		end)
		local t1 = os.clock()
		while os.clock() - t1 < 2 do
			if dc.LockedTarget == item then
				locked = true
				break
			end
			task.wait(0.1)
		end
		if locked then
			break
		end
	end
	if not locked then
		Hub.ShopStatus = T("tutma olmadi: ") .. item.Name
		return
	end
	-- 3) esyayi kasaya surukle (Stepped: oyunun kendi dongusunden sonra, fizikten once)
	local target = bp.Position + Vector3.new(0, 2, 0)
	local conn = RunService.Stepped:Connect(function()
		if dc.LockedTarget == item then
			pcall(function()
				dc:Toggle(nil, target)
			end)
		end
	end)
	tpToPos(bp.Position, 6)
	local placed = false
	local t2 = os.clock()
	while os.clock() - t2 < 7 and State.running do
		task.wait(0.2)
		local ip = posOf(item)
		if ip and (ip - bp.Position).Magnitude < 8 then
			placed = true
			break
		end
		touchBusy()
	end
	task.wait(0.4)
	conn:Disconnect()
	pcall(function()
		dc:ReleaseLockedTarget(true)
	end)
	task.wait(0.6)
	Hub.ShopStatus = placed and (T("goturuldu: ") .. item.Name) or (T("yerlesmedi: ") .. item.Name)
	-- 4) satin al
	pcall(function()
		service("ShopService"):Buy(bp)
	end)
	Hub.ShopDone = Hub.ShopDone + 1
	Hub.ShopBought[item] = true
	task.wait(1.5)
	-- 5) aldigimiz esyayi bul
	local gotT = findTool(function(t)
		return t.Name == item.Name
	end)
	if gotT then
		Hub.ShopStatus = T("elde: ") .. gotT.Name
	else
		local bpp = bp.Position
		local got, gotD = nil, 40
		local items = Workspace:FindFirstChild("Items")
		if items then
			for _, it in ipairs(items:GetChildren()) do
				if it ~= item and it.Name == item.Name and canStore(it) then
					local q = posOf(it)
					if q and (q - bpp).Magnitude < gotD then
						got, gotD = it, (q - bpp).Magnitude
					end
				end
			end
		end
		if got and GA(got, "Tool") == true then
			local isvc = service("InteractionService")
			tpToPos(posOf(got), 3)
			task.wait(0.5)
			for _ = 1, 3 do
				if not got.Parent then
					break
				end
				pcall(function()
					isvc:Interact(got)
				end)
				task.wait(0.9)
			end
			Hub.ShopStatus = T("elde: ") .. got.Name
		elseif got and ensureBag() and bagPickup(got) then
			Hub.ShopStatus = T("cantaya alindi: ") .. got.Name
		end
	end
end

task.spawn(function()
	while State.running do
