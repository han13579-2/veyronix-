local function buildSpots()
	local map, names = {}, {}
	for _, f in ipairs(fortressModels()) do
		local short = string.gsub(f.m.Name, "^Fortress_", "")
		for _, kind in ipairs({ "Shop", "Sell", "Scrap" }) do
			local nm = T(KIND_LABEL[kind]) .. ": " .. short
			map[nm] = { fort = f.m, kind = kind }
			names[#names + 1] = nm
		end
	end
	-- kalelerin disinda kalan satis noktalari (ornek: egitim kampi)
	for _, p in ipairs(CollectionService:GetTagged("SellPart")) do
		if p:IsA("BasePart") then
			local top = topChild(p)
			local tn = top.Name
			if tn ~= "Chunks" and string.sub(tn, 1, 8) ~= "CutScene" then
				local nm = T("Satis") .. ": " .. tn
				if not map[nm] then
					map[nm] = { pos = p.Position }
					names[#names + 1] = nm
				end
			end
		end
	end
	return map, names
end

local function gotoSpot(e)
	if not e or not acquire("spot-tp") then
		return
	end
	pcall(function()
		local target
		if e.fort then
			local root = posOf(e.fort)
			local est = root + KIND_OFF[e.kind]
			local function find()
				local best, bd = nil, 1e12
				for _, p in ipairs(CollectionService:GetTagged(KIND_TAG[e.kind])) do
					if p:IsA("BasePart") and p:IsDescendantOf(e.fort) then
						local d = (p.Position - est).Magnitude
						if d < bd then
							best, bd = p, d
						end
					end
				end
				return best
			end
			local part = find()
			if not part then
				tpToPos(est, 10)
				local t0 = os.clock()
				while os.clock() - t0 < 5 and not part do
					pulse(est)
					task.wait(0.25)
					part = find()
					touchBusy()
				end
			end
			target = part and part.Position or est
		else
			target = e.pos
		end
		tpToPos(target, 5)
	end)
	-- float / otomasyon 15sn bu noktada beklesin
	Hub.BusyTag = "spot-tp"
	task.delay(15, function()
		if Hub.BusyTag == "spot-tp" then
			release()
		end
	end)
end

