	if not d then
		return nil
	end
	local base = drillBehindPos()
	if not base then
		return nil
	end
	local okb, bcf = pcall(function()
		return d:GetBoundingBox()
	end)
	if okb and bcf then
		local dir = bcf.Position - base
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude > 0.5 then
			return base + dir.Unit * math.min(Config.DumpShift, dir.Magnitude)
