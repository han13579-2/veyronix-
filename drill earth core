-- ===== Harita kaydi (her 100000m blok icin ayri dosya: OreFarm/map_block_N.json) =====
-- 100000 metre = haritanin sonu; ondan sonra "Infinite" bant baslayip harita degisiyor.
local HttpService = game:GetService("HttpService")
local okDS, DepthScale = pcall(function()
	return require(ReplicatedStorage.Shared.Util.DepthScale)
end)
local MAP_DIR = "OreFarm"
local Rec = { blocks = {}, cur = 0, lastWrite = {}, dirty = {} }

local function r1(n)
	return math.floor(n + 0.5)
end

local function depthMeters(pos)
	if okDS and DepthScale and pos then
		local ok, v = pcall(function()
			return DepthScale.GetLogicalMetersFromWorldPosition(pos)
		end)
		if ok and type(v) == "number" then
			return v
		end
	end
	return 0
end

local function blockPath(n)
	return MAP_DIR .. "/map_block_" .. n .. "_" .. tostring(Workspace:GetAttribute("SessionRunSeed") or 0) .. ".json"
end

local function getBlock(n)
	local b = Rec.blocks[n]
	if b then
		return b
	end
	b = { block = n, models = {}, ores = {}, items = {}, shops = {}, meta = {} }
	pcall(function()
		if typeof(isfile) == "function" and isfile(blockPath(n)) then
			local d = HttpService:JSONDecode(readfile(blockPath(n)))
			if type(d) == "table" then
				for _, k in ipairs({ "models", "ores", "items", "shops" }) do
					if type(d[k]) == "table" then
						b[k] = d[k]
					end
				end
				if type(d.meta) == "table" then
					b.meta = d.meta
				end
			end
		end
	end)
	Rec.blocks[n] = b
	for k, o in pairs(b.ores) do
		if type(o) == "table" and o.x and not Hub.OreMem[k] then
			Hub.OreMem[k] = { t = o.t, x = o.x, y = o.y, z = o.z }
		end
	end
	return b
end

local DUNGEON_PAT = { "Dungeon", "SpiderPit", "SpiderTunnel", "VampireMansion", "Mineshaft" }
local SKIP_MODELS = { Drill = true, GunEmulator = true, YourCrate = true }
local function modelKind(name)
	for _, p in ipairs(DUNGEON_PAT) do
		if string.find(name, p, 1, true) then
			return "dungeon"
		end
	end
	return "camp"
end

local function countOf(t)
	local c = 0
	for _ in pairs(t) do
		c = c + 1
	end
	return c
end

local function recordScan()
	local h = hrp()
	if not h then
		return
	end
	local meters = depthMeters(h.Position)
	local n = math.max(0, math.floor(meters / 100000))
	Rec.cur = n
	local b = getBlock(n)
	local changed = false
	b.meta.seed = Workspace:GetAttribute("SessionRunSeed")
	b.meta.band = Workspace:GetAttribute("InfiniteBandIndex")
	if os.clock() - (Rec._m or 0) > 10 then
		Rec._m = os.clock()
		for _, m in ipairs(Workspace:GetChildren()) do
			if m:IsA("Model") and not SKIP_MODELS[m.Name] and m ~= LocalPlayer.Character and not string.find(m.Name, "_CameraFocus", 1, true) then
				local p = posOf(m)
				if p then
					local key = m.Name .. "|" .. r1(p.X) .. "|" .. r1(p.Z)
					if not b.models[key] then
						b.models[key] = { n = m.Name, k = modelKind(m.Name), x = r1(p.X), y = r1(p.Y), z = r1(p.Z), m = r1(depthMeters(p)) }
						changed = true
					end
				end
			end
		end
		local seenShop = {}
		for _, it in ipairs(CollectionService:GetTagged("ShopItem")) do
			local p = posOf(it)
			if p then
				local key = r1(p.X / 150) .. "|" .. r1(p.Z / 150) .. "|" .. r1(p.Y / 150)
				if not seenShop[key] then
					seenShop[key] = true
					if not b.shops[key] then
						b.shops[key] = { x = r1(p.X), y = r1(p.Y), z = r1(p.Z) }
						changed = true
					end
				end
			end
		end
	end
	local of = Workspace:FindFirstChild("Ores")
	if of then
		for _, o in ipairs(of:GetChildren()) do
			local p = posOf(o)
			if p then
				local key = o.Name .. "|" .. r1(p.X) .. "|" .. r1(p.Z)
				if not b.ores[key] then
					b.ores[key] = { n = o.Name, t = sessionTypeOf(o), x = r1(p.X), y = r1(p.Y), z = r1(p.Z), m = r1(depthMeters(p)) }
					changed = true
				end
			end
		end
	end
	local items = Workspace:FindFirstChild("Items")
	if items then
		for _, it in ipairs(items:GetChildren()) do
			if it.Name ~= "Money_Sack" and it.Name ~= "SoulOrb" and not Hub.Dropped[it] and not CollectionService:HasTag(it, "ShopItem") then
				local p = posOf(it)
				if p then
					local key = it.Name .. "|" .. r1(p.X) .. "|" .. r1(p.Z)
					if not b.items[key] then
						b.items[key] = { n = it.Name, c = GA(it, "Class"), x = r1(p.X), y = r1(p.Y), z = r1(p.Z), m = r1(depthMeters(p)) }
						changed = true
					end
				end
			end
		end
	end
	if changed then
		Rec.dirty[n] = true
	end
	if Rec.dirty[n] and os.clock() - (Rec.lastWrite[n] or 0) > 10 then
		Rec.lastWrite[n] = os.clock()
		Rec.dirty[n] = nil
		pcall(function()
			if typeof(makefolder) == "function" and typeof(isfolder) == "function" and not isfolder(MAP_DIR) then
				makefolder(MAP_DIR)
			end
			b.meta.saved = os.time()
			b.meta.meters = r1(meters)
			writefile(blockPath(n), HttpService:JSONEncode(b))
		end)
	end
	Hub.MapStatus = string.format(T("blok %d (%dm) | yapi %d | cevher %d | esya %d | shop %d"), n, r1(meters), countOf(b.models), countOf(b.ores), countOf(b.items), countOf(b.shops))
end

