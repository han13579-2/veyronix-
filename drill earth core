-- ===== Shop kumeleri (Shop butonlari icin) =====
local function computeShops()
	local clusters = {}
	for _, it in ipairs(CollectionService:GetTagged("ShopItem")) do
		local p = posOf(it)
		if p then
			local placed = false
			for _, c in ipairs(clusters) do
				if (c.center - p).Magnitude <= 150 then
					c.sum = c.sum + p
					c.n = c.n + 1
					c.center = c.sum / c.n
					placed = true
					break
				end
			end
			if not placed then
				clusters[#clusters + 1] = { sum = p, n = 1, center = p }
			end
		end
	end
	table.sort(clusters, function(a, b)
		if math.abs(a.center.X - b.center.X) > 150 then
			return a.center.X < b.center.X
		end
		return a.center.Y < b.center.Y
	end)
	return clusters
end

