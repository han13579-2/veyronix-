addConn(RunService.Heartbeat:Connect(function()
	if not State.running then
		return
	end
	local t = State.target
	local mining = Config.AutoMine and Config.Float and isAlive() and not _G.HubBusy
	local active = mining and t and t.Parent
	if not active then
		if mining and not Config.Fly and not Config.GodMode then
			-- HOLD: cevher kirilsa bile oldugun yerde havada asili kal (dusme)
			local hh = hrp()
			if hh then
				if not Hub.HoldCF then
					Hub.HoldCF = hh.CFrame
				end
				setNoClip(true)
				hh.CFrame = Hub.HoldCF
				hh.AssemblyLinearVelocity = Vector3.zero
				hh.AssemblyAngularVelocity = Vector3.zero
			end
			return
		end
		Hub.HoldCF = nil
		if Hub._NoClip and not _G.HubBusy and not Config.GodMode and not Config.NoClip then
			setNoClip(false)
		end
		return
	end
	local h = hrp()
	local pos = posOf(t)
	if not h or not pos then
		return
	end
	setNoClip(true)
	local cur = h.Position
	local flat = Vector3.new(pos.X - cur.X, 0, pos.Z - cur.Z)
	local dirH
	if flat.Magnitude > 0.5 then
		dirH = flat.Unit
	else
		local lv = h.CFrame.LookVector
		local lf = Vector3.new(lv.X, 0, lv.Z)
		dirH = lf.Magnitude > 0.1 and lf.Unit or Vector3.new(0, 0, -1)
	end
	local dest = pos - dirH * Config.StandOff + Vector3.new(0, Config.FloatHeight, 0)
	local newPos
	if (dest - cur).Magnitude > 2 then
		newPos = cur:Lerp(dest, 0.35)
	else
		newPos = dest
	end
	h.CFrame = CFrame.new(newPos, Vector3.new(pos.X, newPos.Y, pos.Z))
	h.AssemblyLinearVelocity = Vector3.zero
	h.AssemblyAngularVelocity = Vector3.zero
	Hub.HoldCF = h.CFrame
end))


