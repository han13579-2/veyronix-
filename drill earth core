	if m <= 0 then
		return 100, f, m
	end
	return f / m * 100, f, m
end

-- ===== Gear slot mantigi =====
local ARMOR_SLOT = { Head = "Helmet", Helmet = "Helmet", Torso = "Chest", Chest = "Chest", Leg = "Legs", Legs = "Legs", Boot = "Boots", Boots = "Boots" }
local GUN_CATS = { ["Primary Gun"] = true, ["Secondary Gun"] = true, ["Primary Weapon"] = true, ["Secondary Weapon"] = true }
local GUN_CLASS = { Rifle = "Primary Gun", Revolver = "Secondary Gun", Shotgun = "Gun:Shotgun" }

local function slotOf(x)
	local at = GA(x, "ArmorType")
	if at ~= nil then
		return "Armor:" .. (ARMOR_SLOT[at] or tostring(at))
	end
	if GA(x, "Category") == "Armor" then
		return nil
	end
	local cls = GA(x, "Class")
	if cls == "Sword" or cls == "Pickaxe" then
		return cls
	end
	local dc = GA(x, "DisplayCategory")
	if GUN_CATS[dc] then
		return dc
	end
	if GUN_CLASS[cls] then
		return GUN_CLASS[cls]
	end
	return nil
end

local function scoreOf(x, slot)
	if string.sub(slot, 1, 6) == "Armor:" then
		local a = GA(x, "Armor")
		return type(a) == "number" and a or 0
	end
	local d = GA(x, "Damage")
	local v = GA(x, "Value")
	return (type(d) == "number" and d or 0) * 1000 + (type(v) == "number" and v or 0) * 0.001
end

-- elde/sirtta/giyili en iyi skorlar (slot -> skor)
local function currentBest()
	local best = {}
	local function consider(slot, score)
		if slot and (best[slot] == nil or score > best[slot]) then
			best[slot] = score
		end
	end
	local function scanTools(container)
		if not container then
			return
		end
		for _, t in ipairs(container:GetChildren()) do
			if t:IsA("Tool") then
				local s = slotOf(t)
				if s then
					consider(s, scoreOf(t, s))
				end
			end
		end
	end
	local ch = LocalPlayer.Character
	scanTools(ch)
	scanTools(LocalPlayer:FindFirstChildOfClass("Backpack"))
	if ch then
		for _, d in ipairs(ch:GetChildren()) do
			local an = d:GetAttribute("ArmorName")
			local at = d:GetAttribute("ArmorType")
			if typeof(an) == "string" and an ~= "" and at ~= nil then
				local slot = "Armor:" .. (ARMOR_SLOT[at] or tostring(at))
				local a = GA(an, "Armor")
				consider(slot, type(a) == "number" and a or 0)
			end
		end
	end
	return best
end

