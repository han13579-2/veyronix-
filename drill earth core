local function applyCardResult(c, res, id)
	if typeof(res) ~= "table" or res.Success ~= true or res.ClaimedOfferId ~= id then
		Hub.CardStatus = T("reddedildi")
		return
	end
	local uiOpen = false
	pcall(function()
		uiOpen = c.UpgradeUI ~= nil and c.UpgradeUI.Enabled == true
	end)
	if uiOpen then
		pcall(function()
			c:HandleClassRewardChoiceResult(res, id)
		end)
		return
	end
	if c.ActiveClassReward and c.ActiveClassReward.Id == id then
		c.ActiveClassReward = nil
	end
	c.LastClaimedClassRewardOfferId = math.max(c.LastClaimedClassRewardOfferId or 0, id)
	pcall(function()
		c:SetPurchasePending(false)
	end)
	if res.NextOffer then
		pcall(function()
			c:ReceiveClassRewardOffer(res.NextOffer, false)
		end)
	end
end

local awaitPromise
awaitPromise = function(p, timeout)
	if type(p) ~= "table" or not p.andThen then
		return p
	end
	local done, val = false, nil
	p:andThen(function(a)
		val = a
		done = true
	end):catch(function()
		done = true
	end)
	local t0 = os.clock()
	while not done and os.clock() - t0 < (timeout or 3) do
		task.wait(0.05)
	end
	return val
end

local CardCache = { coins = 0, at = 0 }
local function getCoins()
	if os.clock() - CardCache.at > 0.4 then
		local cs = service("CurrencyService")
		if cs then
			local v = tonumber(awaitPromise(cs:GetCurrency(), 2))
			if v then
				CardCache.coins = v
			end
		end
		CardCache.at = os.clock()
	end
	return CardCache.coins
end

local function cardStep()
	local c = ctrl("DrillUpgradeController")
	if not c then
		Hub.CardStatus = T("teklif yok")
		return false
	end
	local offer = c.ActiveClassReward
	-- 1) ucretsiz sinif odulu
	if offer and typeof(offer.Id) == "number" and typeof(offer.Options) == "table" then
		local lastTry = Hub.CardTry[offer.Id]
		if not lastTry or os.clock() - lastTry > 4 then
			local best, bestRank = nil, 1e9
			for _, op in ipairs(offer.Options) do
				local nm = nil
				if typeof(op) == "string" then
					nm = op
				elseif typeof(op) == "table" then
					nm = op.UpgradeName or op.Name
				end
				if nm and Hub.CardOn[nm] ~= false then
					local r = Hub.CardRank[nm] or 99
					if r < bestRank then
						best, bestRank = nm, r
					end
				end
			end
			if best then
				Hub.CardTry[offer.Id] = os.clock()
				Hub.CardStatus = best
				local id = offer.Id
				local svc = service("DrillService")
				local ok, r = pcall(function()
					return svc:ChooseClassReward(id, best)
				end)
				if ok then
					if typeof(r) == "table" and r.andThen then
						pcall(function()
							r:andThen(function(res)
								applyCardResult(c, res, id)
							end):catch(function() end)
						end)
					else
						applyCardResult(c, r, id)
					end
				end
				return true
			end
			Hub.CardStatus = T("filtre disi")
		end
		-- sinif odulu filtre disi/bekliyor: normal kartlara da bak
	end
	-- 2) normal kartlar: siradaki en iyi, bakiyesi yeten karti SATIN AL
	local opts = c.Options
	if type(opts) ~= "table" or #opts == 0 then
		if not offer then
			Hub.CardStatus = T("teklif yok")
		end
		return false
	end
	if c.PurchasePending or c.OptionsFetchPending then
		return false
	end
	local ds = service("DrillService")
	if not ds then
		return false
	end
	local coins = getCoins()
	local best, bestRank = nil, 1e9
	for _, op in ipairs(opts) do
		if type(op) == "table" and op.Type ~= "Robux" and op.UpgradeName and Hub.CardOn[op.UpgradeName] ~= false then
			local cost = tonumber(op.Cost) or 0
			if cost <= coins then
				local r = Hub.CardRank[op.UpgradeName] or 99
				if r < bestRank then
					best, bestRank = op, r
				end
			end
		end
	end
	if not best then
		Hub.CardStatus = T("uygun/yeterli kart yok") .. " (" .. tostring(coins) .. ")"
		return false
	end
	local ok = awaitPromise(ds:UpgradeDrill(best.UpgradeName, c.OptionsVersion), 3)
	CardCache.at = 0
	Hub.CardStatus = (ok == true and T("satin alindi: ") or T("satin alinamadi: ")) .. best.UpgradeName .. " (" .. tostring(best.Cost) .. ")"
	return ok == true
end

