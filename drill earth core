-- ===== Larry: goblin cesetlerini ayri topla -> Larry'ye birak -> madalya ile kartlari (upgrade) satin al =====
-- LarryConfig.Corpses: Goblin1-3, Goblin_Loot, Goblin_Poison, Goblin4-5, Goblin_Brute, Goblin_Knight, Goblin_Lord, Goblin_Champion
-- (Void on ekli olanlar dahil). Madalya = deger/10. Satin alma icin Larry'nin 20 stud yakininda olmak gerekiyor.
local LarryConfigMod = nil
pcall(function()
	LarryConfigMod = require(ReplicatedStorage.Shared.LarryConfig)
end)

local function larryStation()
	local st = RealWorkspace:FindFirstChild("LieutenantLarrys")
	if st and st.Parent then
		return st
	end
	for _, m in ipairs(RealWorkspace:GetDescendants()) do
		if m:IsA("Model") and m.Name == "LieutenantLarrys" then
			return m
		end
	end
	return nil
end

local function larryCollectPart(st)
	for _, p in ipairs(CollectionService:GetTagged("LarryCollector")) do
		if p:IsA("BasePart") then
			return p
		end
	end
	local p = st and st:FindFirstChild("CorpseCollect", true)
	if p and p:IsA("BasePart") then
		return p
	end
	return nil
end

local function larryAnchor(st)
	local part = larryCollectPart(st) or st:FindFirstChild("LarrySpawn", true)
	if not part then
		local l = st:FindFirstChild("Lieutenant Larry", true)
		part = l and l:FindFirstChild("HumanoidRootPart")
	end
	if part and part:IsA("BasePart") then
		return part.Position
	end
	local ss = st:FindFirstChild("SellSpot", true)
	return posOf(ss or st)
end

-- istasyona tam isinlan (once bolgeyi yukle, sonra gercek parcaya git)
local function goToLarry(st)
	local est = posOf(st:FindFirstChild("SellSpot", true) or st)
	if not est then
		return nil
	end
	tpToPos(est, 8)
	local t0 = os.clock()
	while os.clock() - t0 < 5 do
		pulse(est)
		task.wait(0.3)
		touchBusy()
		if larryCollectPart(st) then
			break
		end
	end
	local pos = larryAnchor(st)
	if pos then
		tpToPos(pos, 4)
	end
	return pos
end

local function larryState()
	local svc = service("LarryService")
	if not svc then
		return nil
	end
	local ok, st = pcall(function()
		return awaitPromise(svc:GetState(), 3)
	end)
	if ok and type(st) == "table" then
		return st
	end
	return nil
end

-- Larry'nin yaninda: satin alinabilir her karti siraya gore al
local function buyLarryUpgrades(st)
	local svc = service("LarryService")
	local state = larryState()
	if not svc or not state or not state.Available then
		Hub.LarryStatus = T("durum alinamadi")
		return 0
	end
	local bought = 0
	for _ = 1, 40 do
		local progressed = false
		for _, id in ipairs(Hub.LarryRank) do
			if not State.running then
				return bought
			end
			local cost = (LarryConfigMod and LarryConfigMod.Upgrades[id] and LarryConfigMod.Upgrades[id].Cost) or 0
			if Hub.LarryOn[id] ~= false and state.Available[id] and (state.Medals or 0) >= cost then
				Hub.LarryStatus = T("aliniyor: ") .. id
				local ok = awaitPromise(svc:BuyUpgrade(id, st), 3)
				touchBusy()
				state = larryState() or state
				if ok then
					bought = bought + 1
					progressed = true
				end
				break
			end
		end
		if not progressed then
			break
		end
	end
	if bought > 0 then
		Hub.LarryStatus = T("alinan kart: ") .. bought .. " | " .. T("madalya: ") .. tostring(state.Medals or 0)
	else
		Hub.LarryStatus = T("madalya: ") .. tostring(state.Medals or 0)
	end
	return bought
end

local function isGoblinCorpse(it)
	if it:GetAttribute("Category") ~= "Corpse" and GA(it, "Category") ~= "Corpse" then
		return false
	end
	if typeof(it:GetAttribute("CorpsePlayerUserId")) == "number" then
		return false
	end
	local rn = it:GetAttribute("RealName")
	if LarryConfigMod and type(rn) == "string" then
		return LarryConfigMod.GetCorpse(rn) ~= nil
	end
	return string.find(it.Name, "Goblin", 1, true) ~= nil
end

local function corpseList()
	local list, seen = {}, {}
	local me = charPivot()
	local function add(it)
		if seen[it] or not it.Parent or not isGoblinCorpse(it) or recentlyFailed(it) then
			return
		end
		seen[it] = true
		local p = posOf(it)
		if p then
			local def = LarryConfigMod and LarryConfigMod.GetCorpse(it:GetAttribute("RealName") or "")
			list[#list + 1] = { it = it, d = (p - me).Magnitude, v = (def and def.Value) or 1 }
		end
	end
	local items = RealWorkspace:FindFirstChild("Items")
	if items then
		for _, it in ipairs(items:GetChildren()) do
			add(it)
		end
	end
	for it in pairs(World.corpses) do
		add(it)
	end
	table.sort(list, function(a, b)
		if a.v ~= b.v then
			return a.v > b.v
		end
		return a.d < b.d
	end)
	return list
end

-- bir cesedi surukleyip Larry'ye birak
local function deliverCorpse(corpse, st)
	local dc = ctrl("DragController")
	if not dc then
		Hub.CorpseStatus = T("DragController yok")
		return false
	end
	local cp = posOf(corpse)
	if not cp then
		return false
	end
	local before = (larryState() or {}).Medals or 0
	tpToPos(cp, 3)
	task.wait(0.6)
	local locked = false
	for _try = 1, 3 do
		pcall(function()
			dc:TryLockTarget(corpse)
		end)
		local t1 = os.clock()
		while os.clock() - t1 < 1.5 do
			if dc.LockedTarget == corpse then
				locked = true
				break
			end
			task.wait(0.1)
		end
		if locked then
			break
		end
	end
	if not locked then
		Hub.CorpseStatus = T("tutma olmadi: ") .. corpse.Name
		return false
	end
	local cpart = larryCollectPart(st)
	local ssp = st:FindFirstChild("SellSpot", true)
	local dest = cpart and cpart.Position or ((ssp and posOf(ssp) or larryAnchor(st) or posOf(st)) + Vector3.new(0, 4, 0))
	local conn = RunService.Stepped:Connect(function()
		if dc.LockedTarget == corpse then
			pcall(function()
				dc:Toggle(nil, dest)
			end)
		end
	end)
	tpToPos(dest, 5)
	local t2 = os.clock()
	local arrived = false
	while os.clock() - t2 < 7 and State.running do
		task.wait(0.2)
		if not corpse.Parent then
			arrived = true
			break
		end
		local ip = posOf(corpse)
		if ip and (ip - dest).Magnitude < 9 then
			arrived = true
			break
		end
		touchBusy()
	end
	task.wait(0.8)
	conn:Disconnect()
	pcall(function()
		dc:ReleaseLockedTarget(true)
	end)
	task.wait(1.2)
	local after = (larryState() or {}).Medals or before
	local ok = (not corpse.Parent) or after > before
	Hub.CorpseStatus = (ok and T("teslim: ") or T("teslim edilemedi: ")) .. corpse.Name .. " (+" .. tostring(after - before) .. ")"
	if not ok then
		Hub.Fail[corpse] = os.clock()
	end
	return ok and arrived
end

task.spawn(function()
	local lastStateAt, canBuyCached = 0, false
	while State.running do
		local ok, err = pcall(function()
			if not ((Hub.CorpseAuto or Hub.LarryAuto) and isAlive()) or _G.HubBusy then
