local God = { floorY = nil, camPart = nil, on = false }

local function godFloorAt(x, z, hintY)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = { LocalPlayer.Character, God.camPart }
	local hit = Workspace:Raycast(Vector3.new(x, hintY + 6, z), Vector3.new(0, -60, 0), rp)
	if hit then
		return hit.Position.Y
	end
	return nil
end

addConn(RunService.Heartbeat:Connect(function(dt)
	if not State.running then
		return
	end
	local want = Config.GodMode and isAlive()
	if not want then
		if God.on then
			God.on = false
			local h0 = hrp()
			if h0 and God.floorY then
				h0.CFrame = CFrame.new(h0.Position.X, God.floorY + 3.5, h0.Position.Z)
				h0.AssemblyLinearVelocity = Vector3.zero
			end
			setNoClip(false)
		end
		return
	end
	local h = hrp()
	if not h then
		return
	end
	if not God.on then
		God.on = true
		God.floorY = godFloorAt(h.Position.X, h.Position.Z, h.Position.Y - 3) or (h.Position.Y - 3)
	end
	local mining = Config.AutoMine and Config.Float and State.target and State.target.Parent
	if _G.HubBusy or mining then
		return
	end
	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	local cur = h.Position
	local nx, nz = cur.X, cur.Z
	if hum then
		local md = hum.MoveDirection
		nx = nx + md.X * hum.WalkSpeed * dt
		nz = nz + md.Z * hum.WalkSpeed * dt
	end
	local gy = godFloorAt(nx, nz, God.floorY)
	if gy and math.abs(gy - God.floorY) < 30 then
		God.floorY = gy
	end
	setNoClip(true)
	-- yatay, yuz yere bakacak sekilde (90 derece)
	local gcam = Workspace.CurrentCamera
	local yaw = 0
	if gcam then
		local lv = gcam.CFrame.LookVector
		yaw = math.atan2(-lv.X, -lv.Z)
	end
	h.CFrame = CFrame.new(nx, God.floorY + Config.GodOffset, nz) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	h.AssemblyLinearVelocity = Vector3.zero
	h.AssemblyAngularVelocity = Vector3.zero
end))

