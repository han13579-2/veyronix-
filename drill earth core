local function oreNear(p, r)
	local f = Workspace:FindFirstChild("Ores")
	if not f then
		return false
	end
	for _, o in ipairs(f:GetChildren()) do
		local op = posOf(o)
		if op and (op - p).Magnitude <= r and isOreEnabled(sessionTypeOf(o)) and oreHealth(o) > 0 then
			return true
		end
	end
	return false
end

local function bestRememberedOre()
	local me = charPivot()
	local bestKey, bestPos, bd = nil, nil, nil
	for key, o in pairs(Hub.OreMem) do
		if isOreEnabled(o.t) and not (Hub.OreSkip[key] and os.clock() - Hub.OreSkip[key] < 60) then
			local p = Vector3.new(o.x, o.y, o.z)
			local d = (p - me).Magnitude
			if d > 150 and (bd == nil or d < bd) then
				bestKey, bestPos, bd = key, p, d
			end
		end
	end
	return bestKey, bestPos, bd
end

-- Workspace.Ores'ta uygun cevher yoksa: hafizadaki (veya taramayla bulunan) en yakin cevhere git
local function gotoRecordedOre()
	if _G.HubBusy then
		return false
	end
	local bestKey, bestPos, bd = bestRememberedOre()
	if not bestKey and os.clock() - (Hub.LastOreSweep or 0) > Config.OreSweepEvery then
		if not acquire("ore-sweep") then
			return false
		end
		Hub.LastOreSweep = os.clock()
		State.status = T("cevherler araniyor (harita taramasi)")
		sweepStream(function()
			touchBusy()
			if Config.MapRecord then
				pcall(recordScan)
			end
			return false
		end, function()
			return not Config.AutoMine
		end)
		release()
		bestKey, bestPos, bd = bestRememberedOre()
	end
	if not bestKey or not acquire("ore-travel") then
		return false
	end
	State.status = T("cevhere gidiyor ") .. math.floor(bd) .. "m"
	tpToPos(bestPos, 6)
	local t0 = os.clock()
	local found = false
	while os.clock() - t0 < 6 and State.running do
		task.wait(0.3)
		touchBusy()
		if oreNear(bestPos, 400) then
			found = true
			break
		end
	end
	Hub.OreSkip[bestKey] = os.clock()
	if not found then
		Hub.OreMem[bestKey] = nil
	end
	release()
	return found
end

-- ===== Anti-Streaming: surekli, ayni anda cok konum =====
task.spawn(function()
	local list, builtAt, idx, lastD = {}, 0, 0, false
	while State.running do
		if Config.AntiStream and isAlive() then
			local inD = LocalPlayer:GetAttribute("InDungeon") == true
			if inD ~= lastD or #list == 0 or os.clock() - builtAt > (inD and 3 or 20) then
				lastD = inD
				list = streamPositions()
				builtAt = os.clock()
				idx = 0
			end
			local n = #list
			if n > 0 then
				local cnt = math.min(n, inD and 40 or Config.StreamBatch)
				for _ = 1, cnt do
					idx = idx % n + 1
					pulse(list[idx])
				end
			end
			task.wait(math.max(0.1, inD and math.min(Config.PulseEvery, 1) or Config.PulseEvery))
		else
			task.wait(1)
		end
	end
end)

