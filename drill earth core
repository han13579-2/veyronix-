local RealWorkspace = game:GetService("Workspace")
local World = { items = {}, ores = {}, corpses = {} }
local function listOf(set)
	local t = {}
	for d in pairs(set) do
		if d.Parent then
			t[#t + 1] = d
		else
			set[d] = nil
		end
	end
	return t
end
local ItemsView = { GetChildren = function()
	return listOf(World.items)
end }
local OresView = { GetChildren = function()
	return listOf(World.ores)
end }
local Workspace = setmetatable({}, {
	__index = function(_, k)
		local v = RealWorkspace[k]
		if type(v) == "function" then
			return function(_, ...)
				if k == "FindFirstChild" then
					local n = ...
					if n == "Items" then
						return ItemsView
					end
					if n == "Ores" then
						return OresView
					end
				end
				return v(RealWorkspace, ...)
			end
		end
		return v
	end,
})

