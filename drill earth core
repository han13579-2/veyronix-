		return tostring(v or "")
	end
	return ""
end

local function isOreEnabled(sessionType)
	local s = string.lower(sessionType or "")
	if s == "" then
		return false
	end
	for base, on in pairs(Config.Ores) do
		if on and string.find(s, string.lower(base), 1, true) then
			return true
		end
	end
	return false
end

local function oreHealth(ore)
	local h = ore:FindFirstChild("Health")
	if h and typeof(h.Value) == "number" then
		return h.Value
	end
	return 1
end

local function findNearestOre()
	local oresFolder = Workspace:FindFirstChild("Ores")
	if not oresFolder then
		return nil, 0
	end
	local myPos = charPivot()
	local best, bestD = nil, Config.OreRange
	for _, ore in ipairs(oresFolder:GetChildren()) do
		local st = sessionTypeOf(ore)
		if st ~= "" and isOreEnabled(st) and oreHealth(ore) > 0 then
			local pos = posOf(ore)
			if pos then
				local d = (pos - myPos).Magnitude
				if d <= Config.OreRange and (best == nil or d < bestD) then
					best, bestD = ore, d
				end
			end
		end
	end
	return best, bestD
end

local function swingAt(ore)
	if not ore or not ore.Parent or not isAlive() then
