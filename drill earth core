-- ===== Oto toplama (uzaktan cantaya; olmazsa yanina isinlanir) =====
-- Canli test: Pickup remote'u mesafe siniri olmadan calisiyor (23000+ stud, 0.13sn).
local function pickupCandidates(fuelOnly, maxRange)
	local list = {}
	local items = Workspace:FindFirstChild("Items")
	if not items then
		return list
	end
	local myPos = charPivot()
	local dung = dungeonPositions()
	local inDungeon = LocalPlayer:GetAttribute("InDungeon") == true
	for _, it in ipairs(items:GetChildren()) do
		if canStore(it) and not recentlyFailed(it) and not Hub.Dropped[it] and (not fuelOnly or isFuelItem(it)) then
			local p = posOf(it)
			if p then
				local d = (p - myPos).Magnitude
				if d <= maxRange then
					local pri = 2
					if inDungeon then
						pri = 1
					else
						for _, dp in ipairs(dung) do
							if (dp - p).Magnitude < 250 then
								pri = 1
								break
							end
						end
					end
					list[#list + 1] = { it = it, d = d, pri = pri }
				end
			end
		end
	end
	table.sort(list, function(a, b)
		if a.pri ~= b.pri then
			return a.pri < b.pri
		end
		return a.d > b.d
	end)
	return list
end

local function dumpBag()
	local drop = drillDumpPos()
	if not drop then
		Hub.PickStatus = T("drill yok")
		return false
	end
	local itemsF = Workspace:FindFirstChild("Items")
	local before = {}
	if itemsF then
		for _, it in ipairs(itemsF:GetChildren()) do
			before[it] = true
		end
	end
	local back = tpSave()
	tpToPos(drop, 6)
	task.wait(0.7)
	local svc = getToolService()
	pcall(function()
		svc.Update:Fire({ "DropAll" })
	end)
	local t0 = os.clock()
	while os.clock() - t0 < 5 do
		task.wait(0.2)
		local s = bagInfo()
		if s == 0 then
			break
		end
	end
	task.wait(0.5)
	if itemsF then
		for _, it in ipairs(itemsF:GetChildren()) do
			if not before[it] then
				Hub.Dropped[it] = true
			end
		end
	end
	tpBack(back)
	Hub.PickDumped = (Hub.PickDumped or 0) + 1
	return true
end

-- yuklu esyalari topla; (toplanan, canta_dolu_ve_bosaltma_kapali)
-- Boru hatli: sunucu ~0.15-0.2sn'de bir toplamaya izin veriyor (canli test: 0.2sn aralikta 2/2, 0.12sn'de 1/2).
-- Esyalar Config.PickupInterval araliginda arka arkaya atilir, sonra dogrulanir, kacirilanlar tekrar denenir.
local function pickPass()
	local n = 0
	local list = pickupCandidates(Hub.FuelAuto, Config.PickupRange)
	local i = 1
	while i <= #list do
		if not State.running or not isAlive() or not Config.AutoPickup then
			break
		end
		local s, m = bagInfo()
		if s == nil then
			ensureBag()
			s, m = bagInfo()
		end
		if s and m and s >= m then
			if Hub.AutoDump and dumpBag() then
				ensureBag()
				s, m = bagInfo()
				if s and m and s >= m then
					return n, true
				end
			else
				return n, true
			end
		end
		local room = (s and m) and (m - s) or 5
		if room < 1 then
			room = 1
		end
		local batch = {}
		while #batch < room and #batch < 8 and i <= #list do
			if list[i].it.Parent then
				batch[#batch + 1] = list[i]
			end
			i = i + 1
		end
		local svc = getToolService()
		for _, e in ipairs(batch) do
			if not State.running or not Config.AutoPickup then
				break
			end
			pcall(function()
				svc.Update:Fire({ "Pickup", e.it })
			end)
			task.wait(Config.PickupInterval)
		end
		local t0 = os.clock()
		while os.clock() - t0 < 0.8 do
			local all = true
			for _, e in ipairs(batch) do
				if e.it.Parent then
					all = false
					break
				end
			end
			if all then
				break
			end
			task.wait(0.05)
		end
		for _, e in ipairs(batch) do
			local it = e.it
			local ok = it.Parent == nil
			if not ok then
				local s2, m2 = bagInfo()
				if s2 and m2 and s2 >= m2 then
					-- canta dolu: basarisiz sayma, dongu basinda bosaltilir
					list = pickupCandidates(Hub.FuelAuto, Config.PickupRange)
					i = 1
					break
				end
				ok = bagPickup(it, 1.0)
			end
			if not ok and it.Parent and Config.PickupTp then
				local p = posOf(it)
				if p then
					local back = tpSave()
					tpToPos(p, 3)
					task.wait(0.5)
					ok = bagPickup(it, 2.0)
					tpBack(back)
				end
			end
			if ok then
				n = n + 1
				State.picked = State.picked + 1
				Hub.PickLast = it.Name .. " " .. math.floor(e.d) .. "m"
			elseif it.Parent then
				Hub.Fail[it] = os.clock()
			end
		end
		touchBusy()
	end
	return n, false
end

task.spawn(function()
	local lastSweep = 0
	while State.running do
		local waitT = math.max(0.1, Config.ScanTick)
		if Config.AutoPickup and isAlive() then
			local loaded = #pickupCandidates(Hub.FuelAuto, Config.PickupRange)
			local sweepDue = os.clock() - lastSweep > Config.PickupSweepEvery
			if (loaded > 0 or sweepDue) and not _G.HubBusy and acquire("pickup") then
				local total = 0
				local fullStop = false
				pcall(function()
					if not ensureBag() then
						Hub.PickStatus = T("canta yok")
						return
					end
					local n, full = pickPass()
					total = total + n
					fullStop = full
					if sweepDue and not fullStop then
						lastSweep = os.clock()
						sweepStream(function()
							Hub.PickStatus = T("tarama ") .. tostring(Hub.SweepIdx) .. "/" .. tostring(Hub.SweepTotal) .. T(" alinan ") .. total
							local n2, f2 = pickPass()
							total = total + n2
							touchBusy()
							if Config.MapRecord then
								pcall(recordScan)
							end
							if f2 then
								fullStop = true
								return true
							end
							return false
						end, function()
							return not Config.AutoPickup
						end)
					end
					if fullStop then
						Hub.PickStatus = T("canta dolu")
					else
						Hub.PickStatus = T("alindi: ") .. total .. T(" (son: ") .. tostring(Hub.PickLast) .. ")"
					end
				end)
				release()
				if fullStop then
					waitT = 15
				end
			end
		else
			waitT = 1
		end
		task.wait(waitT)
	end
end)

