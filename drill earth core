local MAIN_PARTS = { "HumanoidRootPart", "Head", "UpperTorso", "LowerTorso", "Torso" }
local function setNoClip(on)
	local ch = LocalPlayer.Character
	if not ch then
		return
	end
	if on then
		if os.clock() - (Hub._NoClipAt or 0) < 0.3 then
			return
		end
		Hub._NoClipAt = os.clock()
		for _, p in ipairs(ch:GetDescendants()) do
			if p:IsA("BasePart") and p.CanCollide then
				p.CanCollide = false
			end
		end
		Hub._NoClip = true
	elseif Hub._NoClip then
		for _, n in ipairs(MAIN_PARTS) do
			local p = ch:FindFirstChild(n)
			if p and p:IsA("BasePart") then
				p.CanCollide = true
			end
		end
		Hub._NoClip = false
	end
end

